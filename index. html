        });

        // Copy Bank Account Number Function
        function copyRekening() {
            const rekNo = document.getElementById('rekening-no').innerText.replace(/\s+/g, '');
            navigator.clipboard.writeText(rekNo).then(() => {
                const btnText = document.getElementById('copy-btn-text');
                btnText.innerText = 'Tersalin!';
                setTimeout(() => {
                    btnText.innerText = 'Salin No. Rekening';
                }, 2000);
            });
        }

        // Auto Select Package when clicked from menu section
        function selectPackage(packageName) {
            const selectElem = document.getElementById('packageSelect');
            for (let i = 0; i < selectElem.options.length; i++) {
                if (selectElem.options[i].value.includes(packageName.split(' ')[0])) {
                    selectElem.selectedIndex = i;
                    break;
                }
            }
        }

        // WhatsApp Order Direct Link Form Handler
        function sendToWhatsApp(event) {
            event.preventDefault();

            const name = document.getElementById('buyerName').value;
            const packageVal = document.getElementById('packageSelect').value;
            const qty = document.getElementById('portionQty').value;
            const payment = document.querySelector('input[name="paymentMethod"]:checked').value;
            const address = document.getElementById('deliveryAddress').value;
            const notes = document.getElementById('orderNotes').value || '-';

            const sellerPhone = '6281232806305';

            // Format WhatsApp Message Text
            const message = `Halo *Udang Keju Chewwy*, saya mau pesan!%0A%0A` +
                `📌 *Detail Pesanan:*%0A` +
                `• *Nama Pembeli:* ${encodeURIComponent(name)}%0A` +
                `• *Paket:* ${encodeURIComponent(packageVal)}%0A` +
                `• *Jumlah:* ${encodeURIComponent(qty)} porsi%0A` +
                `• *Metode Pembayaran:* ${encodeURIComponent(payment)}%0A%0A` +
                `📍 *Alamat Pengiriman:*%0A${encodeURIComponent(address)}%0A%0A` +
                `📝 *Catatan:* ${encodeURIComponent(notes)}%0A%0A` +
                `Mohon diproses ya, terima kasih!`;

            // Redirect to WhatsApp
            const waUrl = `https://wa.me/${sellerPhone}?text=${message}`;
            window.open(waUrl, '_blank');
        }
